# Copy to .env.local and fill in. The anon key is public by design (it only has the
# access RLS grants a signed-in user); NEVER put the service_role key in this app.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key from Supabase dashboard -> Project Settings -> API>
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
